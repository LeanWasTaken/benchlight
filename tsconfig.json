{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "tokens",
    "vue",
    "nuxt",
    "vite/index.d.ts",
    "scripts/lib",
    "tests",
    "playground",
    "showcase",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "fixtures", "playground/dist", "showcase/dist"]
}
