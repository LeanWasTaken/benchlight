{
  "name": "benchlight",
  "version": "0.2.1",
  "packageManager": "bun@1.2.21",
  "private": true,
  "description": "Benchlight, the design system for Krists's personal web projects",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "tokens",
    "css",
    "tailwind",
    "js",
    "fonts",
    "vue",
    "nuxt",
    "vite",
    "dist",
    "API.md"
  ],
  "exports": {
    "./tokens": {
      "types": "./tokens/index.ts",
      "default": "./dist/tokens.js"
    },
    "./css/*": "./css/*",
    "./tailwind/theme.css": "./tailwind/theme.css",
    "./js/*": "./js/*",
    "./fonts/*": "./fonts/*",
    "./vue": "./vue/index.ts",
    "./nuxt": "./nuxt/module.ts",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "lint:workflows": "docker run --rm -v \"$PWD\":/repo --workdir /repo rhysd/actionlint:1.7.12 -color",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "gen": "bun scripts/gen-tokens.ts && bun scripts/gen-prepaint.ts && bun run gen:js",
    "gen:js": "bun build ./tokens/index.ts --outfile dist/tokens.js --format esm && bun build ./js/appearance.js --outfile dist/appearance.min.js --minify",
    "bundle": "bun scripts/bundle.ts",
    "build": "bun run gen && bun run bundle && bun run gen:api",
    "gen:api": "bun scripts/gen-api.ts",
    "fixtures": "bun scripts/fixtures.ts",
    "playground": "vite playground",
    "test:visual": "playwright test"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/node": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.0",
    "vue-component-meta": "^3.3.12",
    "vue-tsc": "^3.3.12"
  }
}
